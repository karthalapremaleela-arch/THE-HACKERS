# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Set MONGODB_URI to a real MongoDB instance if available, e.g.:
# MONGODB_URI=mongodb://localhost:27017/bloodconnect
# Or leave blank / set to 'memory' to automatically use the embedded in-memory MongoDB for zero-configuration testing and running!
MONGODB_URI=memory

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-for-bloodconnect-demo-change-in-production-2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Default Demo Admin Credentials (Seed data)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@bloodconnect.local
ADMIN_PASSWORD=AdminDemo@2026

# Demo / Simulation Flags
DEMO_MODE=true
MOCK_DISCOVERY_ENABLED=true
MOCK_NOTIFICATIONS_ENABLED=true
